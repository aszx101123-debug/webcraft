{
  "name": "webcraft",
  "version": "1.10.0",
  "private": true,
  "description": "브라우저 블록 샌드박스 게임 WebCraft",
  "scripts": {
    "start": "npx --yes serve .",
    "test": "node test/run-tests.js && node --test tests/*.test.js && npm --prefix server test",
